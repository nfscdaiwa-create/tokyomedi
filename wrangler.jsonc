{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tokyomedi",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "assets": {"directory": "./public"},
  "previews": {},
  "observability": {
    "enabled": true,
    "traces": {"enabled": true}
  },
  "routes": [
    {"pattern": "tokyomedi.com", "custom_domain": true},
    {"pattern": "www.tokyomedi.com", "custom_domain": true}
  ]
}
